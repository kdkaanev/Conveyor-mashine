<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MAIN" Id="{aff8891b-0ab8-4b58-9f64-30fb6c1d1e1a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	Conveyor		:	FB_Conveyor;
	StartTrigger 	: 	R_TRIG;
	StopTrigger		:	R_TRIG;
	EmergencyOn		:	R_TRIG;
	Reset			:	R_TRIG; 
	
	
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Conveyor(
    Start := GVL_IO.StartButton,
    Stop := GVL_IO.StopButton,
    EmergencyStop := GVL_IO.EmergencyStop,
    Reset := GVL_IO.Reset,
	AutoMode := GVL_IO.AutoMode,
	Mode := GVL_IO.Mode
);

GVL_IO.Motor := Conveyor.Motor;
GVL_IO.MotorStopped := NOT Conveyor.Motor;
GVL_IO.GreenLamp := Conveyor.GreenLamp;
GVL_IO.RedLamp := Conveyor.RedLamp;
GVL_IO.FaultLamp := Conveyor.FaultLamp;
GVL_IO.FaultCode := Conveyor.FaultCode;

GVL_IO.FaultCode := Conveyor.FaultCode;

IF GVL_IO.Mode = E_ConveyorMode.AUTO THEN
	StartTrigger(CLK := GVL_IO.StartButton);
END_IF

StopTrigger(CLK := GVL_IO.StopButton);
EmergencyOn(CLK:= GVL_IO.EmergencyStop);
Reset(CLK:=GVL_IO.Reset);


IF StartTrigger.Q THEN
    GVL_IO.StartButton := FALSE;
END_IF;
IF StopTrigger.Q THEN
	GVL_IO.StopButton := FALSE;
END_IF
IF EmergencyOn.Q THEN
	GVL_IO.EmergencyStop := FALSE;
END_IF
IF Reset.Q THEN
	GVL_IO.Reset := FALSE;
END_IF


CASE GVL_IO.FaultCode OF
    E_FaultCode.FC_NONE:
        GVL_IO.FaultText := 'NO FAULT';

    E_FaultCode.FC_EMERGENCY_STOP:
        GVL_IO.FaultText := 'EMERGENCY STOP';

    E_FaultCode.FC_EXIT_TIMEOUT:
        GVL_IO.FaultText := 'EXIT SENSOR TIMEOUT';
END_CASE

IF GVL_IO.AutoMode THEN
    GVL_IO.Mode := E_ConveyorMode.AUTO;
ELSE
    GVL_IO.Mode := E_ConveyorMode.MANUAL;
END_IF

IF GVL_IO.Mode = E_ConveyorMode.AUTO THEN
	GVL_IO.ModeText := 'AUTO';
ELSIF GVL_IO.Mode = E_ConveyorMode.MANUAL THEN
	GVL_IO.ModeText := 'MANUAL'; 
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>