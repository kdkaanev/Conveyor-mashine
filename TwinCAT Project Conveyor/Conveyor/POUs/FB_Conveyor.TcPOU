<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_Conveyor" Id="{e691a8aa-df53-4498-ae74-d15bcd0b3190}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Conveyor
VAR_INPUT
	
	Start			:	BOOL;
	Stop			:	BOOL;
	EmergencyStop	:	BOOL;
	Reset			:	BOOL;
	
	AutoMode      	:	BOOL;
	SensorEntry   	: 	BOOL;
    SensorExit    	: 	BOOL;
	
END_VAR
VAR_OUTPUT
	
	Motor 		: BOOL;
	GreenLamp 	: BOOL;
	RedLamp 	: BOOL;
	FaultLamp	: BOOL;
	
END_VAR
VAR
	
   
   
	
	State 	: 	E_ConveyorState ;
	Mode	:	E_ConveyorMode;
	
	ModeChanged 	: BOOL;
    PreviousMode 	: E_ConveyorMode;

  
	
	TimerPart		:	TON;
	ExitTrigger		:	R_TRIG;
	EntryTrigger 	: 	R_TRIG;
	Counter 		: 	UDINT := 0;
	
	InterlockOK 	: 	BOOL;
	
	FaultCode : E_FaultCode := E_FaultCode.FC_NONE;
	
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TimerPart(
    	IN := (Mode = E_ConveyorMode.AUTO)
          	AND 
				(State = E_ConveyorState.WAIT_EXIT),
    	PT := T#10S
	);
ExitTrigger(CLK := SensorExit);	
EntryTrigger(CLK := SensorEntry);
ModeChanged := Mode <> PreviousMode;

IF NOT HandleFaults() THEN
    IF ModeChanged THEN
        State := E_ConveyorState.IDLE;

    ELSIF Mode = E_ConveyorMode.AUTO THEN
        RunAuto();

    ELSIF Mode = E_ConveyorMode.MANUAL THEN
        RunManual();
    END_IF
END_IF

(*
IF EmergencyStop THEN
	State := E_ConveyorState.FAULT;
	FaultCode := E_FaultCode.FC_EMERGENCY_STOP;
ELSIF Reset AND State = E_ConveyorState.FAULT THEN
	State := E_ConveyorState.IDLE;
	FaultCode := E_FaultCode.FC_NONE;
ELSE 
	IF State = E_ConveyorState.FAULT THEN
		// // Запазваме State и FaultCode
	ELSIF ModeChanged THEN
		State := E_ConveyorState.IDLE;
	ELSIF Mode = E_ConveyorMode.AUTO THEN
    	RunAuto();
	ELSIF Mode = E_ConveyorMode.MANUAL THEN
    		RunManual();
	END_IF
		
END_IF
*)
PreviousMode := Mode;
Motor := (State = E_ConveyorState.RUNNING) OR (State = E_ConveyorState.WAIT_EXIT);
GreenLamp := (State = E_ConveyorState.RUNNING) OR (State = E_ConveyorState.WAIT_EXIT);
RedLamp := State = E_ConveyorState.IDLE;
FaultLamp := State = E_ConveyorState.FAULT;
]]></ST>
    </Implementation>
    <Method Name="HandleFaults" Id="{0142073b-7014-404b-b3cf-64a9e958afe6}">
      <Declaration><![CDATA[METHOD HandleFaults : BOOL
VAR_INPUT
END_VAR

VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HandleFaults := FALSE;

IF EmergencyStop THEN
    State := E_ConveyorState.FAULT;
    FaultCode := E_FaultCode.FC_EMERGENCY_STOP;
    HandleFaults := TRUE;

ELSIF Reset AND State = E_ConveyorState.FAULT THEN
    State := E_ConveyorState.IDLE;
    FaultCode := E_FaultCode.FC_NONE;
    HandleFaults := TRUE;

ELSIF State = E_ConveyorState.FAULT THEN
    HandleFaults := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunAuto" Id="{1694a31d-b738-4af3-b469-e300ec7d2e2d}">
      <Declaration><![CDATA[METHOD RunAuto
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF SensorExit THEN
    InterlockOK := FALSE;
ELSE
    InterlockOK := TRUE;
END_IF

CASE State OF

    E_ConveyorState.IDLE:
        IF Start AND InterlockOK THEN
            State := E_ConveyorState.RUNNING;
        END_IF

    E_ConveyorState.RUNNING:
        IF EntryTrigger.Q THEN
            State := E_ConveyorState.WAIT_EXIT;
        ELSIF Stop THEN
            State := E_ConveyorState.IDLE;
        END_IF

    E_ConveyorState.WAIT_EXIT:
        IF TimerPart.Q THEN
            State := E_ConveyorState.FAULT;
            FaultCode := E_FaultCode.FC_EXIT_TIMEOUT;
        ELSIF ExitTrigger.Q THEN
            State := E_ConveyorState.RUNNING;
            Counter := Counter + 1;
        ELSIF Stop THEN
            State := E_ConveyorState.IDLE;
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunManual" Id="{d7dffffb-616f-4be3-b62f-b75890a221ae}">
      <Declaration><![CDATA[METHOD RunManual
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF State <> E_ConveyorState.FAULT THEN
    IF Start THEN
        State := E_ConveyorState.RUNNING;
    ELSE
        State := E_ConveyorState.IDLE;
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
